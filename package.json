  "scripts": {
    "start": "react-scripts start",
    "build": "sh -ac '. .env.production; react-app-rewired build' --experimentalChunkGranularity small",
    "build:development": "REACT_APP_ENV=development yarn run build",
    "build:staging": "REACT_APP_ENV=staging yarn run build",
    "build:production": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint \"**/*.+(ts|tsx)\" --ignore-pattern 'node_modules/'",
    "prettier": "prettier --ignore-path .gitignore \"**/*.+(ts|tsx)\"",
    "format": "yarn run prettier -- --write",
    "check-format": "yarn run prettier -- --list-different",
    "prepare": "husky install"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
